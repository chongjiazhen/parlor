# Raw run output - regenerable, and git is not a data store. A run that evidences
# a claim is rendered to transcripts/, and the transcript is what gets committed.
eval/records/

*.local.md

/.scratch/
/.worktrees/
local/

.claude/settings.local.json

# Build output from `pip install -e .`. The packaging INPUT is tracked
# (pyproject.toml); what setuptools generates from it is not.
*.egg-info/
build/
dist/
games/*/packs/*/
!games/*/packs/example/
